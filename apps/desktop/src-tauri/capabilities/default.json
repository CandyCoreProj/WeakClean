{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "สิทธิ์ของหน้าต่างหลัก: ใช้ API พื้นฐาน + ปุ่มย่อ/ขยาย/ปิด และลากหน้าต่างจากแถบหัว",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "dialog:allow-open"
  ]
}
